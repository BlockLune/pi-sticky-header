{
  "name": "pi-sticky-header",
  "version": "0.1.0",
  "description": "A sticky user-prompt header for Pi's fullscreen terminal UI.",
  "keywords": [
    "extension",
    "pi",
    "pi-package",
    "sticky-header"
  ],
  "homepage": "https://github.com/BlockLune/pi-sticky-header#readme",
  "bugs": {
    "url": "https://github.com/BlockLune/pi-sticky-header/issues"
  },
  "license": "MIT",
  "author": "BlockLune",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlockLune/pi-sticky-header.git"
  },
  "files": [
    "sticky-header.ts",
    "src",
    "README.md",
    "LICENSE",
    "scripts/install-hooks.mjs"
  ],
  "type": "module",
  "scripts": {
    "dev": "pi -e ./sticky-header.ts",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage",
    "hooks:install": "simple-git-hooks",
    "prepare": "node scripts/install-hooks.mjs",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "lint-staged": "17.6.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "simple-git-hooks": "2.14.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm check"
  },
  "lint-staged": {
    "*.{ts,mts,cts}": [
      "oxlint --deny-warnings",
      "oxfmt"
    ],
    "*.{js,mjs,cjs}": [
      "oxlint --deny-warnings",
      "oxfmt"
    ],
    "*.{json,jsonc,md,yml,yaml}": "oxfmt"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.9.0",
  "pi": {
    "extensions": [
      "./sticky-header.ts"
    ]
  }
}
